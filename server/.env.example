# Salin ke .env lalu isi bagian supabase dan redis.
#
# Berkas ini dibaca otomatis saat startup (internal/config/dotenv.go).
# Environment variable yang sudah diset di proses TIDAK akan ditimpa —
# urutan prioritas: environment proses > .env > nilai bawaan di kode.

# ---- application ----
APP_ENV=development           # development | staging | production
APP_VERSION=dev

# ---- http ----
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
# Daftar origin dipisah koma. Kalau memakai Cloudflare Tunnel (alamat HTTPS
# tetap — lihat docs/cloudflare-tunnel.md), tambahkan https://api.<domainmu>.
HTTP_CORS_ORIGINS=http://localhost:3000

# ---- websocket ----
WS_PATH=/api/v1/ws
WS_READ_LIMIT_BYTES=65536     # 64 KB. Media lewat HTTP upload, bukan lewat socket.
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_INTERVAL=25s          # harus < WS_PONG_WAIT
WS_SEND_BUFFER=64             # frame ter-buffer per client sebelum dianggap slow consumer
WS_ALLOWED_ORIGINS=http://localhost:3000
WS_PRESENCE_TTL=90s           # harus > WS_PING_INTERVAL, kalau tidak status online berkedip

# ---- supabase ----
# Dashboard > Project Settings > API
#
# Aplikasi TIDAK terhubung langsung ke PostgreSQL. Seluruh akses data lewat
# PostgREST (/rest/v1) dan GoTrue (/auth/v1), jadi yang dibutuhkan hanya URL
# proyek dan anon key — bukan sandi database.
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key bersifat publik dan memang dirancang untuk ditanam di aplikasi
# klien. Ia TIDAK memberi hak akses apa pun dengan sendirinya: yang menentukan
# baris mana yang boleh disentuh adalah RLS, dievaluasi terhadap JWT pengguna
# yang diteruskan server pada setiap permintaan.
SUPABASE_ANON_KEY=

# OPSIONAL, dan sebaiknya dibiarkan kosong.
# Kunci ini MELEWATI RLS sepenuhnya. Isi hanya kalau memang ada pekerjaan latar
# yang tidak mewakili pengguna tertentu (job moderasi, backfill). Jangan pernah
# memakainya sekadar untuk melewati query yang tertahan RLS — itu menghapus
# seluruh lapisan keamanan sekaligus.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_TIMEOUT=10s
SUPABASE_AUTH_CACHE_TTL=1m    # lama hasil verifikasi token disimpan di memori

# Bucket Supabase Storage untuk media. WAJIB dibuat dulu di
# Dashboard > Storage, dan dijadikan public agar URL baca bisa dipakai klien.
SUPABASE_STORAGE_BUCKET=media

# ---- redis ----
# Supabase tidak menyediakan Redis. Dipakai untuk presence, rate limit, dan
# fanout WebSocket antar-instance.
#
# Lokal (Memurai/Docker):  redis://localhost:6379/0
# Upstash (TLS):           rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ---- auth ----
# Autentikasi memakai Supabase Auth. Klien Kotlin login lewat Supabase SDK,
# lalu mengirim JWT-nya ke server ini; server meneruskan JWT itu ke Supabase
# pada setiap permintaan sehingga auth.uid() terisi dan RLS bekerja.
#
# HANYA untuk development. Mengizinkan header X-Debug-User sebagai identitas.
# Wajib false di staging/production; startup akan menolak kalau tidak.
#
# Perlu diketahui: dengan bypass ini token bukan JWT Supabase, sehingga
# auth.uid() kosong dan SEMUA query data akan ditolak RLS. Bypass hanya
# berguna untuk menguji routing dan jalur socket, bukan jalur data.
AUTH_DEV_BYPASS=false

# ---- voice room (LiveKit) ----
# Backend ini TIDAK mengalirkan suara — audio realtime butuh UDP/WebRTC dan
# tidak bisa lewat WebSocket berbasis TCP. Yang dilakukan backend: menerbitkan
# token yang menentukan siapa boleh masuk dan siapa boleh bicara.
#
# Tanpa ketiga nilai ini, voice room tetap bisa dibuat dan didaftar, tetapi
# TIDAK akan mengeluarkan suara sama sekali.
#
# Cara tercepat: daftar gratis di https://cloud.livekit.io, buat project,
# salin API Key + Secret + WebSocket URL. Alternatif self-host: jalankan
# `docker run livekit/livekit-server --dev`.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ---- logging ----
LOG_LEVEL=debug               # debug | info | warn | error
LOG_FORMAT=pretty             # pretty | text | json
#   pretty : ringkas & berwarna, untuk dipantau langsung di terminal
#   text   : key=value bawaan slog, lengkap tapi sering terlipat
#   json   : WAJIB di production, dibaca mesin
